# GEMINI_API_KEY: Required for Gemini AI writing assistance (server-side only)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: SQLite database path (default: file:mailflow.db)
DATABASE_URL="file:mailflow.db"

# EMAIL PROVIDER CONFIGURATION (Optional - defaults to Ethereal Sandbox with live web previews if empty)
# Option 1: Resend (Recommended for production)
RESEND_API_KEY=""

# Option 2: Custom SMTP (e.g. SendGrid, Mailgun, Amazon SES, Postmark, or Gmail SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
